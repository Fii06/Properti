<% content_for :title, "Contact" %>
<% content_for :active_nav, "contact" %>

<main id="content" class="container">
  <section class="hero">
    <span class="badge">Contact</span>
    <h1>Let’s talk</h1>
  </section>

  <section class="section">
    <form class="card card-content" data-static-contact-form="true">
      <div class="form-row">
        <div>
          <label for="name">Name</label>
          <input class="input" id="name" required />
        </div>
        <div>
          <label for="email">Email</label>
          <input class="input" id="email" type="email" required />
        </div>
      </div>
      <div>
        <label for="message">Message</label>
        <textarea id="message" rows="5" class="input" required></textarea>
      </div>
      <p><button class="btn" type="submit">Send</button></p>
    </form>
  </section>
</main>
