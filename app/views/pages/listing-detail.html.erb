<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Detail Properti · SPK Properti</title>
  <%= stylesheet_link_tag "application", media: "all" %>
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="container navbar">

    <%= link_to root_path, class: "logo", aria: { label: "SPK Properti Home" } do %>
      SPK<span>Properti</span>
    <% end %>

    <nav class="nav-links" id="nav-links" aria-label="Primary">
      <%= link_to "Home", root_path %>
      <%= link_to "Listings", listings_path, class: "active" %>
      <%= link_to "Agents", agents_path %>
      <%= link_to "Neighborhoods", neighborhoods_path %>      
      <%= link_to "Services", services_path %>
      <%= link_to "Blog", blog_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>  
    </nav>

    <div class="controls">
      <button id="themeToggle" class="btn ghost" type="button" aria-label="Toggle dark mode">🌓</button>
      <button id="hamburger" class="hamburger" type="button" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- CONTENT -->
<main class="container">

  <!-- HERO -->
  <section class="hero">
    <p class="badge">Detail Properti</p>
    <h1><%= @propertis.alamat %></h1>
    <p class="meta">
      Luas Tanah: <%= @propertis.luas_tanah %> m² ·
      Luas Bangunan: <%= @propertis.luas_bangunan %> m²
    </p>
  </section>

  <section class="section">
    <h2>Galeri Properti</h2>
    <div class="grid cols-3">
      <% @propertis.images.each do |img| %>
        <article class="card">
          <img src="<%= img %>" alt="Foto Properti">
        </article>
      <% end %>
    </div>
  </section>

  <section class="section card card-content">
    <h3>Harga Jual</h3>
    <p style="font-size:1.4rem;font-weight:bold">
      <%= number_to_currency(@propertis.harga_final) %>
    </p>
  </section>

  <!-- GALLERY -->
  <section class="section">
    <div class="grid cols-3">
      <% @propertis.images.each do |img| %>
        <div class="card">
          <%= image_tag img, alt: "Foto Properti", loading: "lazy" %>
        </div>
      <% end %>
    </div>
  </section>

  <!-- INFO -->
  <section class="section">
    <div class="grid cols-2">

      <div class="card card-content">
        <h3>Informasi Properti</h3>
        <p><strong>Alamat:</strong> <%= @propertis.alamat %></p>
        <p><strong>Luas Tanah:</strong> <%= @propertis.luas_tanah %> m²</p>
        <p><strong>Luas Bangunan:</strong> <%= @propertis.luas_bangunan %> m²</p>
      </div>

      <div class="card card-content">
        <h3>Harga Jual</h3>
        <p class="price">
          <%= number_to_currency(@propertis.harga_final, unit: "Rp ") %>
        </p>

        <p class="meta">
          Harga sudah dihitung menggunakan sistem SPK
        </p>

        <%= link_to "Hubungi Penjual", contact_path, class: "btn block" %>
      </div>

    </div>
  </section>

</main>

<!-- FOOTER -->
<footer>
  <div class="container footer-inner">
    <div>© 2025 SPK Properti</div>
    <div>
      <%= link_to "Privacy", privacy_path %> ·
      <%= link_to "Terms", terms_path %>
    </div>
  </div>
</footer>

</body>
</html>
