<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SPK Properti</title>
  <%= stylesheet_link_tag "application", media: "all" %>
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="container navbar">

    <%= link_to root_path, class: "logo", aria: { label: "SPK Properti Home" } do %>
      SPK<span>Properti</span>
    <% end %>

    <nav class="nav-links" id="nav-links" aria-label="Primary">
      <%= link_to "Home", root_path, class: "active" %>
      <%= link_to "Listings", listings_path %>
      <%= link_to "Agents", agents_path %>
      <%= link_to "Neighborhoods", neighborhoods_path %>      
      <%= link_to "Services", services_path %>
      <%= link_to "Blog", blog_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>  
    </nav>

    <div class="controls">
      <button id="themeToggle" class="btn ghost" type="button" aria-label="Toggle dark mode">🌓</button>
      <button id="hamburger" class="hamburger" type="button" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- MAIN -->
<main class="container">

  <!-- HERO -->
  <section class="hero hero-with-slider">

    <!-- LEFT: SLIDER -->
    <div class="hero-slider">
      <div class="slides">

        <% @propertis.first(3).each_with_index do |p, i| %>
          <figure class="slide <%= 'is-active' if i == 0 %>">
            <% if p.images.any? %>
              <img src="data:image/jpeg;base64,<%= p.images.first %>" alt="Properti">
            <% end %>
            <figcaption><%= p.alamat %></figcaption>
          </figure>
        <% end %>

      </div>

      <button class="nav prev">‹</button>
      <button class="nav next">›</button>
    </div>

    <!-- RIGHT: TEXT -->
    <div class="hero-content">
      <p class="badge">SPK Property</p>
      <h1>Temukan Harga Properti yang Adil & Masuk Akal</h1>
      <p>
        Sistem Pendukung Keputusan untuk menentukan harga jual properti
        berdasarkan NJOP, luas tanah, dan bangunan.
      </p>

      <div class="hero-actions">
        <%= link_to "Jual Properti", services_path, class: "btn" %>
        <%= link_to "Lihat Listings", listings_path, class: "btn ghost" %>
      </div>
    </div>

  </section>

  <!-- FEATURED LISTINGS -->
  <section class="section">
    <h2>Properti Terbaru</h2>

    <div class="grid cols-3">
      <% @propertis.first(6).each do |p| %>
        <article class="card">

          <% if p.images.any? %>
            <img src="data:image/jpeg;base64,<%= p.images.first %>" alt="Properti">
          <% end %>

          <div class="card-content">
            <h3><%= p.alamat %></h3>
            <div class="meta">
              Harga: <%= number_to_currency(p.harga_pasar, unit: "Rp ") %>
            </div>

            <%= link_to "View Details", listing_path(p), class: "btn block" %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

</main>

<!-- FOOTER -->
<footer>
  <div class="container footer-inner">
    <div>© 2025 SPK Properti</div>
    <div>
      <%= link_to "Privacy", privacy_path %> ·
      <%= link_to "Terms", terms_path %> ·
      <%= link_to "FAQ", faq_path %>
    </div>
  </div>
</footer>

</body>
</html>
