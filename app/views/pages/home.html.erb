<% content_for :title, "Home" %>
<% content_for :active_nav, "home" %>

<main id="content" class="container">
  <section class="hero hero-with-slider">
    <div class="hero-slider">
      <div class="slides">
        <% @propertis.first(3).each_with_index do |properti, index| %>
          <figure class="slide <%= "is-active" if index.zero? %>">
            <% if (image_src = property_image_src(properti.images.first)).present? %>
              <%= image_tag image_src, alt: properti.alamat, loading: "lazy" %>
            <% end %>
            <figcaption><%= properti.alamat %></figcaption>
          </figure>
        <% end %>
      </div>

      <button class="nav prev" type="button" aria-label="Previous slide">‹</button>
      <button class="nav next" type="button" aria-label="Next slide">›</button>
    </div>

    <div class="hero-content">
      <p class="badge">SPK Property</p>
      <h1>Temukan Harga Properti yang Adil & Masuk Akal</h1>
      <p>
        Sistem Pendukung Keputusan untuk menentukan harga jual properti
        berdasarkan NJOP, luas tanah, dan bangunan.
      </p>

      <div class="hero-actions">
        <%= link_to "Jual Properti", services_path, class: "btn" %>
        <%= link_to "Lihat Listings", listings_path, class: "btn ghost" %>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Properti Terbaru</h2>

    <div class="grid cols-3">
      <% @propertis.first(6).each do |properti| %>
        <article class="card">
          <% if (image_src = property_image_src(properti.images.first)).present? %>
            <%= image_tag image_src, alt: properti.alamat, loading: "lazy" %>
          <% end %>
          <div class="card-content">
            <h3><%= properti.alamat %></h3>
            <div class="meta">Harga: <%= rupiah(properti.harga_pasar) %></div>
            <div class="meta">Luas Tanah: <%= properti.luas_tanah %> m²</div>
            <br>
            <%= link_to "View Details", listing_path(properti), class: "btn" %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</main>
