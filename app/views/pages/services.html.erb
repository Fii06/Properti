<% content_for :title, "Services" %>
<% content_for :active_nav, "services" %>

<main id="content" class="container">
  <section class="hero">
    <span class="badge">Services</span>
    <h1>Jual Properti dengan Rekomendasi Harga SPK</h1>
    <p>Masukkan data properti lengkap, lihat estimasi berbasis NJOP Bojongsoang, lalu pilih harga publish terbaik.</p>
  </section>

  <% riwayat_rows = Array(@riwayat_hargas).map { |item| item.respond_to?(:with_indifferent_access) ? item.with_indifferent_access : item } %>
  <% riwayat_rows = [{}] if riwayat_rows.empty? %>
  <% riwayat_rows << {} while riwayat_rows.length < 3 %>
  <% manual_njop = (@manual_njop_input || {}).with_indifferent_access %>

  <section class="section card card-content">
    <% if @properti&.errors&.any? %>
      <div class="alert error">
        <strong>Data belum bisa diproses:</strong>
        <ul class="error-list">
          <% @properti.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: preview_property_path, scope: :propertis, local: true do |f| %>
      <%= f.label :alamat, "Alamat lengkap" %>
      <%= f.text_area :alamat, class: "input", required: true, rows: 3, value: @properti&.alamat %>

      <div class="form-row">
        <div>
          <%= f.label :daerah, "Daerah" %>
          <%= f.text_field :daerah, class: "input", required: true, value: @properti&.daerah %>
        </div>
        <div>
          <%= f.label :kecamatan, "Kecamatan" %>
          <%= f.text_field :kecamatan, class: "input", required: true, value: @properti&.kecamatan %>
        </div>
      </div>

      <div class="form-row">
        <div>
          <%= f.label :kelurahan, "Kelurahan" %>
          <%= f.text_field :kelurahan, class: "input", required: true, value: @properti&.kelurahan %>
        </div>
        <div>
          <%= f.label :status_kepemilikan, "Status kepemilikan" %>
          <%= f.select :status_kepemilikan, options_for_select(Propertis::STATUS_KEPEMILIKAN, @properti&.status_kepemilikan), { prompt: "Pilih status" }, class: "input", required: true %>
        </div>
      </div>

      <div class="form-row">
        <div>
          <%= f.label :latitude, "Latitude" %>
          <%= f.number_field :latitude, class: "input", required: true, step: :any, value: @properti&.latitude %>
        </div>
        <div>
          <%= f.label :longitude, "Longitude" %>
          <%= f.number_field :longitude, class: "input", required: true, step: :any, value: @properti&.longitude %>
        </div>
      </div>
      <p class="helper-text">
        Gunakan koordinat desimal dari pin Google Maps atau OpenStreetMap, misalnya <strong>-6.9901</strong> dan <strong>107.6295</strong>, agar listing otomatis muncul di peta.
      </p>

      <div class="form-row">
        <div>
          <%= f.label :luas_tanah, "Luas tanah (m²)" %>
          <%= f.number_field :luas_tanah, class: "input", required: true, value: @properti&.luas_tanah %>
        </div>
        <div>
          <%= f.label :luas_bangunan, "Luas bangunan (m²)" %>
          <%= f.number_field :luas_bangunan, class: "input", required: true, value: @properti&.luas_bangunan %>
        </div>
      </div>

      <div class="form-row">
        <div>
          <%= f.label :tahun_pembangunan, "Tahun pembangunan" %>
          <%= f.number_field :tahun_pembangunan, class: "input", required: true, value: @properti&.tahun_pembangunan %>
        </div>
        <div>
          <%= f.label :harga_per_m2, "Harga NJOP per m² (Rp)" %>
          <%= f.number_field :harga_per_m2, class: "input", step: :any, required: true, value: manual_njop[:harga_per_m2] %>
        </div>
      </div>

      <div class="section-divider">
        <h2>Referensi NJOP Manual</h2>
      </div>

      <div class="nop-field-group">
        <label for="propertis_kd_propinsi">NOP</label>
        <div class="nop-inline-inputs">
          <%= f.text_field :kd_propinsi, class: "input nop-segment nop-segment-2", required: true, maxlength: 2, value: manual_njop[:kd_propinsi], inputmode: "numeric", aria: { label: "Kode provinsi NJOP" } %>
          <%= f.text_field :kd_dati2, class: "input nop-segment nop-segment-2", required: true, maxlength: 2, value: manual_njop[:kd_dati2], inputmode: "numeric", aria: { label: "Kode dati2 NJOP" } %>
          <%= f.text_field :kd_kecamatan, class: "input nop-segment nop-segment-3", required: true, maxlength: 3, value: manual_njop[:kd_kecamatan], inputmode: "numeric", aria: { label: "Kode kecamatan NJOP" } %>
          <%= f.text_field :kd_kelurahan, class: "input nop-segment nop-segment-3", required: true, maxlength: 3, value: manual_njop[:kd_kelurahan], inputmode: "numeric", aria: { label: "Kode kelurahan NJOP" } %>
          <%= f.text_field :kd_blok, class: "input nop-segment nop-segment-3", required: true, maxlength: 3, value: manual_njop[:kd_blok], inputmode: "numeric", aria: { label: "Kode blok NJOP" } %>
          <%= f.text_field :no_urut, class: "input nop-segment nop-segment-4", required: true, maxlength: 4, value: manual_njop[:no_urut], inputmode: "numeric", aria: { label: "Nomor urut NJOP" } %>
          <%= f.text_field :kd_jns_op, class: "input nop-segment nop-segment-1", required: true, maxlength: 1, value: manual_njop[:kd_jns_op], inputmode: "numeric", aria: { label: "Kode jenis objek pajak" } %>
        </div>
      </div>

      <div class="section-divider">
        <h2>Riwayat Harga Properti</h2>
        <p>Isi minimal satu riwayat untuk membantu sistem membaca anchor harga pasar.</p>
      </div>

      <% riwayat_rows.each_with_index do |riwayat, index| %>
        <div class="form-row">
          <div>
            <label for="propertis_riwayat_hargas_<%= index %>_tanggal">Tanggal riwayat <%= index + 1 %></label>
            <input
              type="date"
              id="propertis_riwayat_hargas_<%= index %>_tanggal"
              name="propertis[riwayat_hargas][][tanggal]"
              class="input"
              value="<%= riwayat[:tanggal] || riwayat['tanggal'] %>"
            >
          </div>
          <div>
            <label for="propertis_riwayat_hargas_<%= index %>_harga">Harga riwayat <%= index + 1 %> (Rp)</label>
            <input
              type="number"
              id="propertis_riwayat_hargas_<%= index %>_harga"
              name="propertis[riwayat_hargas][][harga]"
              class="input"
              value="<%= riwayat[:harga] || riwayat['harga'] %>"
            >
          </div>
        </div>
      <% end %>

      <%= f.label :images, "Foto properti (minimal 5 file)" %>
      <%= f.file_field :images, multiple: true, class: "input", required: @encoded_images.blank? %>
      <% if @encoded_images.present? %>
        <p class="helper-text"><%= @encoded_images.size %> foto siap dipakai untuk publish akhir.</p>
      <% end %>

      <br>
      <%= f.submit "Hitung Rekomendasi Harga", class: "btn" %>
    <% end %>
  </section>

  <% if @rekomendasi.present? && @analysis_result.present? %>
    <section class="section">
      <div class="card card-content">
        <h2>Ringkasan Estimasi</h2>
        <p><%= @analysis_result[:explanation] %></p>
        <div class="meta-stack">
          <div>
            <%= @analysis_result[:njop_source] == "manual_reference" ? "NJOP manual tersimpan" : "Baseline NJOP" %>:
            <strong><%= number_to_currency(@analysis_result[:effective_njop], unit: "Rp ", precision: 0) %></strong> per m²
          </div>
          <div>Nilai tanah: <strong><%= number_to_currency(@analysis_result.dig(:adjustments, :land_value), unit: "Rp ", precision: 0) %></strong></div>
          <div>Nilai bangunan: <strong><%= number_to_currency(@analysis_result.dig(:adjustments, :building_value), unit: "Rp ", precision: 0) %></strong></div>
          <div>Rata-rata riwayat harga: <strong><%= number_to_currency(@analysis_result.dig(:adjustments, :history_anchor), unit: "Rp ", precision: 0) %></strong></div>
          <div>Metode: <strong><%= @analysis_result[:method] %></strong></div>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Pilih Harga Jual</h2>

      <%= form_with url: create_property_path, scope: :propertis, local: true do |f| %>
        <%= hidden_field_tag :preview_token, @preview_token %>

        <% property_hidden_fields = {
          alamat: @properti.alamat,
          daerah: @properti.daerah,
          kecamatan: @properti.kecamatan,
          kelurahan: @properti.kelurahan,
          latitude: @properti.latitude,
          longitude: @properti.longitude,
          luas_tanah: @properti.luas_tanah,
          luas_bangunan: @properti.luas_bangunan,
          tahun_pembangunan: @properti.tahun_pembangunan,
          status_kepemilikan: @properti.status_kepemilikan,
          njop: @properti.njop,
          kd_propinsi: manual_njop[:kd_propinsi],
          kd_dati2: manual_njop[:kd_dati2],
          kd_kecamatan: manual_njop[:kd_kecamatan],
          kd_kelurahan: manual_njop[:kd_kelurahan],
          kd_blok: manual_njop[:kd_blok],
          no_urut: manual_njop[:no_urut],
          kd_jns_op: manual_njop[:kd_jns_op],
          harga_per_m2: manual_njop[:harga_per_m2]
        } %>

        <% property_hidden_fields.each do |key, value| %>
          <%= hidden_field_tag "propertis[#{key}]", value %>
        <% end %>

        <% Array(@riwayat_hargas).each do |riwayat| %>
          <%= hidden_field_tag "propertis[riwayat_hargas][][tanggal]", riwayat[:tanggal] || riwayat["tanggal"] %>
          <%= hidden_field_tag "propertis[riwayat_hargas][][harga]", riwayat[:harga] || riwayat["harga"] %>
        <% end %>

        <div class="grid cols-3">
          <% @rekomendasi.each do |key, value| %>
            <label class="card card-content recommendation-card">
              <%= radio_button_tag :harga_final, value, key == :mid, required: true %>
              <h3><%= key.capitalize %></h3>
              <p class="price"><%= number_to_currency(value, unit: "Rp ", precision: 0) %></p>
              <p class="helper-text">
                <% if key == :min %>
                  Opsi konservatif untuk percepatan jual.
                <% elsif key == :mid %>
                  Opsi seimbang berdasarkan baseline dan atribut properti.
                <% else %>
                  Opsi optimistis dengan ruang negosiasi lebih besar.
                <% end %>
              </p>
            </label>
          <% end %>
        </div>

        <br>
        <%= submit_tag "Simpan & Publikasikan", class: "btn" %>
      <% end %>
    </section>
  <% end %>
</main>
