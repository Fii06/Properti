<% content_for :title, "Blog" %>
<% content_for :active_nav, "blog" %>

<main id="content" class="container">
  <section class="hero">
    <span class="badge">Insights</span>
    <h1>Berita Properti</h1>
    <p>Berita terbaru seputar properti dari Kompas Properti</p>
  </section>

  <section class="section">
    <% if @news.any? %>
      <div class="grid cols-3">
        <% @news.each do |news| %>
          <article class="card">
            <% if news.image.present? %>
              <img src="<%= news.image %>" alt="<%= news.title %>" loading="lazy">
            <% end %>

            <div class="card-content">
              <h3 class="card-title">
                <%= link_to news.title, news.url, target: "_blank", rel: "noopener" %>
              </h3>

              <div class="meta">
                <%= news.source %> •
                <%= news.posted_at.present? ? news.posted_at : news.created_at.strftime("%d %B %Y") %>
              </div>

              <p><%= truncate(news.excerpt, length: 120) %></p>
              <%= link_to "Baca artikel", news.url, class: "btn ghost", target: "_blank", rel: "noopener" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state-panel empty-state">
        <h2>Belum ada berita properti untuk ditampilkan</h2>
        <p>Konten dari Kompas Properti akan muncul di sini setelah tersedia. Sementara itu, Anda bisa melihat daftar properti yang sedang aktif.</p>
      </div>
    <% end %>
  </section>
</main>
