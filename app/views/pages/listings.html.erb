<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Listings · SPK Properti</title>
  <%= stylesheet_link_tag "application", media: "all" %>
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="container navbar">

    <%= link_to root_path, class: "logo", aria: { label: "SPK Properti Home" } do %>
      SPK<span>Properti</span>
    <% end %>

    <nav class="nav-links" id="nav-links" aria-label="Primary">
      <%= link_to "Home", root_path %>
      <%= link_to "Listings", listings_path, class: "active" %>
      <%= link_to "Agents", agents_path %>
      <%= link_to "Neighborhoods", neighborhoods_path %>      
      <%= link_to "Services", services_path %>
      <%= link_to "Blog", blog_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>  
    </nav>

    <div class="controls">
      <button id="themeToggle" class="btn ghost" type="button" aria-label="Toggle dark mode">🌓</button>
      <button id="hamburger" class="hamburger" type="button" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- MAIN CONTENT -->
<main class="container">

  <!-- HERO -->
  <section class="hero">
    <span class="badge">Browse</span>
    <h1>Property Listings</h1>
    <p>Daftar properti yang tersedia berdasarkan data SPK.</p>
    <form method="get" action="<%= listings_path %>" class="card card-content" style="margin-top: 1rem">
      <div class="form-row">
        <div>
          <label for="q">Search</label>
          <input
            class="input"
            id="q"
            name="q"
            value="<%= params[:q] %>"
            placeholder="Alamat, daerah, kecamatan…"
          />
        </div>

        <div>
          <label for="price">Max price</label>
          <select id="price" name="harga_pasar">
            <option value="">Any</option>
            <option value="500000" <%= "selected" if params[:harga_pasar] == "500000" %>>Up to 500k</option>
            <option value="1000000" <%= "selected" if params[:harga_pasar] == "1000000" %>>Up to 1M</option>
            <option value="1500000" <%= "selected" if params[:harga_pasar] == "1500000" %>>Up to 1.5M</option>
            <option value="2000000" <%= "selected" if params[:harga_pasar] == "2000000" %>>Up to 2M</option>
          </select>
        </div>
      </div>

      <div style="margin-top:1rem">
        <%= link_to "Reset", listings_path, class: "btn ghost" %>
      </div>
    </form>
  </section>

  <!-- LISTINGS GRID -->
  <section class="section">
    <div class="grid cols-3">
      <% @propertis.each do |p| %>
        <article class="card">
          <img src="https://picsum.photos/600/400?random=<%= p.id %>" alt="Properti">
          <div class="card-content">
            <h3><%= p.alamat %></h3>
            <div class="meta">Harga: <%= number_to_currency(p.harga_pasar) %></div>
            <div class="meta">Luas Tanah: <%= p.luas_tanah %> m²</div>
            <br>
            <%= link_to "View Details", listing_path(p), class: "btn" %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

</main>

<!-- FOOTER -->
<footer>
  <div class="container footer-inner">
    <div>© 2025 SPK Properti</div>
    <div>
      <%= link_to "Privacy", privacy_path %> ·
      <%= link_to "Terms", terms_path %> ·
      <%= link_to "FAQ", faq_path %>
    </div>
  </div>
</footer>

</body>
</html>
