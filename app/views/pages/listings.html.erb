<% content_for :title, "Listings" %>
<% content_for :active_nav, "listings" %>

<main id="content" class="container">
  <section class="hero">
    <span class="badge">Listing</span>
    <h1>Property Listings</h1>
    <p>Daftar properti yang tersedia berdasarkan data SPK.</p>
    <form method="get" action="<%= listings_path %>" class="card card-content" style="margin-top: 1rem">
      <div class="form-row">
        <div>
          <label for="q">Search</label>
          <input
            class="input"
            id="q"
            name="q"
            value="<%= params[:q] %>"
            placeholder="Alamat, daerah, kecamatan…"
          />
        </div>

        <div>
          <label for="price">Max price</label>
          <select id="price" name="harga_pasar">
            <option value="">Any</option>
            <option value="500000" <%= "selected" if params[:harga_pasar] == "500000" %>>Up to 500k</option>
            <option value="1000000" <%= "selected" if params[:harga_pasar] == "1000000" %>>Up to 1M</option>
            <option value="1500000" <%= "selected" if params[:harga_pasar] == "1500000" %>>Up to 1.5M</option>
            <option value="2000000" <%= "selected" if params[:harga_pasar] == "2000000" %>>Up to 2M</option>
          </select>
        </div>
      </div>

      <div style="margin-top:1rem">
        <button type="submit" class="btn">Apply Filters</button>
        <%= link_to "Reset", listings_path, class: "btn ghost" %>
      </div>
    </form>
  </section>

  <section class="section">
    <% if @propertis.any? %>
      <div class="grid cols-3">
        <% @propertis.each do |properti| %>
          <article class="card">
            <% if (image_src = property_image_src(properti.images.first)).present? %>
              <%= image_tag image_src, alt: properti.alamat, loading: "lazy" %>
            <% end %>
            <div class="card-content">
              <h3><%= properti.alamat %></h3>
              <div class="meta">Harga: <%= rupiah(properti.harga_pasar) %></div>
              <div class="meta">Luas Tanah: <%= properti.luas_tanah %> m²</div>
              <% if properti.contact_penjual.present? %>
                <div class="meta">
                  <%= properti.contact_penjual %>
                </div>
              <% end %>
              <% if properti.latitude.present? && properti.longitude.present? %>
                <div class="meta">Koordinat: <%= properti.latitude %>, <%= properti.longitude %></div>
              <% else %>
                <div class="meta meta-warning">Koordinat belum tersedia</div>
              <% end %>
              <br>
              <%= link_to "View Details", listing_path(properti), class: "btn" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="card card-content empty-state">
        <h2>Belum ada listing yang cocok</h2>
        <p>Coba ubah kata kunci atau batas harga untuk melihat properti lain.</p>
      </div>
    <% end %>
  </section>
</main>
