<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agents · RealtyStarter</title>
    <%= stylesheet_link_tag "application", media: "all" %>
  </head>
    
<header class="site-header">
  <div class="container navbar">

    <%= link_to root_path, class: "logo", aria: { label: "SPK Properti Home" } do %>
      SPK<span>Properti</span>
    <% end %>

    <nav class="nav-links" id="nav-links" aria-label="Primary">
      <%= link_to "Home", root_path %>
      <%= link_to "Listings", listings_path %>
      <%= link_to "Agents", agents_path, class: "active" %>
      <%= link_to "Neighborhoods", neighborhoods_path %>   
      <%= link_to "Services", services_path %>   
      <%= link_to "Blog", blog_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>
    </nav>

    <div class="controls">
      <button
        id="themeToggle"
        class="btn ghost"
        onclick="toggleTheme()"
        aria-pressed="false"
        aria-label="Toggle dark mode"
      >
        🌓
      </button>
      <button
        id="hamburger"
        class="hamburger"
        aria-label="Menu"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>
    <main id="content" class="container">
      <section class="hero">
        <p class="badge">Team</p>
        <h1>Our Agents</h1>
      </section>

      <section class="section">
        <div id="agentGrid" class="grid cols-3"></div>
      </section>
    </main>
    <footer>
      <div class="container footer-inner">
        <div>
          © 2025 RealtyStarter — A student-friendly real estate template.
        </div>
        <div>
          <a href="privacy.html">Privacy</a> · <a href="terms.html">Terms</a> ·
          <a href="faq.html">FAQ</a>
        </div>
      </div>
    </footer>

    <!-- jQuery FIRST -->
    <script
      src="https://code.jquery.com/jquery-3.7.1.min.js"
      integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
      crossorigin="anonymous"
    ></script>
    <!-- Then your main script -->
    <script src="assets/js/main.js"></script>

    <script>
      (async function () {
        const agents = await loadJSON("data/agents.json");
        const $grid = $("#agentGrid");
        agents.forEach((a) =>
          $grid.append(`
          <article class="card">
            <img src="${a.photo}" alt="${a.name}" loading="lazy"/>
            <div class="card-content">
              <h3 class="card-title"><a href="agent-detail.html?id=${a.id}">${a.name}</a></h3>
              <div class="meta">${a.title}</div>
              <p><a class="btn" href="agent-detail.html?id=${a.id}">View Profile</a></p>
            </div>
          </article>`)
        );
      })();
    </script>
  </body>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const hamburger = document.getElementById("hamburger");
      const navLinks = document.getElementById("nav-links");

      if (hamburger && navLinks) {
        // toggle menu
        hamburger.addEventListener("click", function () {
          navLinks.classList.toggle("open");
        });

        // klik luar = tutup menu
        document.addEventListener("click", function (e) {
          if (!navLinks.contains(e.target) && !hamburger.contains(e.target)) {
            navLinks.classList.remove("open");
          }
        });
      }
    });
  </script>
</html>
