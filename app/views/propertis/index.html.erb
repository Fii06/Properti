<h1>Daftar Properti</h1>

<div class="grid cols-3">
  <% @propertis.each do |p| %>
    <article class="card">
      <% if (image_src = property_image_src(p.images.first)).present? %>
        <%= image_tag image_src, alt: p.alamat, loading: "lazy" %>
      <% end %>

      <div class="card-content">
        <h3><%= p.alamat %></h3>
        <div class="meta">
          Harga: <%= rupiah(p.harga_pasar) %>
        </div>

        <%= link_to "View Details", listing_path(p), class: "btn" %>
      </div>
    </article>
  <% end %>
</div>
