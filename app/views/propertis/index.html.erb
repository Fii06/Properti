<h1>Daftar Properti</h1>

<div class="grid cols-3">
  <% @propertis.each do |p| %>
    <article class="card">

      <% if p.images.any? %>
        <img src="data:image/jpeg;base64,<%= p.images.first %>">
      <% end %>

      <div class="card-content">
        <h3><%= p.alamat %></h3>
        <div class="meta">
          Harga: <%= number_to_currency(p.harga_pasar) %>
        </div>

        <%= link_to "View Details", listing_path(p), class: "btn" %>
      </div>
    </article>
  <% end %>
</div>
