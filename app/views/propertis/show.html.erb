<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SPK Properti</title>
  <%= stylesheet_link_tag "application", media: "all" %>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  >
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="container navbar">

    <%= link_to root_path, class: "logo", aria: { label: "SPK Properti Home" } do %>
      SPK<span>Properti</span>
    <% end %>

    <nav class="nav-links" id="nav-links" aria-label="Primary">
      <%= link_to "Home", root_path, class: "active" %>
      <%= link_to "Listings", listings_path %>
      <%= link_to "Agents", agents_path %>
      <%= link_to "Neighborhoods", neighborhoods_path %>      
      <%= link_to "Services", services_path %>
      <%= link_to "Blog", blog_path %>
      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>  
    </nav>

    <div class="controls">
      <button
        id="themeToggle"
        class="btn ghost"
        onclick="toggleTheme()"
        aria-pressed="false"
        aria-label="Toggle dark mode"
      >
        🌓
      </button>
      <button
        id="hamburger"
        class="hamburger"
        aria-label="Menu"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<section class="hero">
  <div class="container">
    <h1 data-page="Detail"><%= @properti.alamat %></h1>
    <p>Informasi lengkap properti</p>
  </div>
</section>

<section class="container" style="margin-top:2rem">
  <div class="grid cols-2">
    <div class="card">
      <div class="card-content">
        <p><strong>Daerah:</strong> <%= @properti.daerah %></p>
        <p><strong>Kecamatan:</strong> <%= @properti.kecamatan %></p>
        <p><strong>Kelurahan:</strong> <%= @properti.kelurahan %></p>
        <p><strong>Luas Tanah:</strong> <%= @properti.luas_tanah %> m²</p>
        <p><strong>Luas Bangunan:</strong> <%= @properti.luas_bangunan %> m²</p>
        <p><strong>Tahun:</strong> <%= @properti.tahun_pembangunan %></p>
        <p><strong>Status Kepemilikan:</strong> <%= @properti.status_kepemilikan %></p>
        <p><strong>NJOP:</strong> Rp <%= number_with_delimiter(@properti.njop.to_i) %> / m²</p>
      </div>
    </div>

    <div class="card">
      <div class="card-content">
        <div class="price">Rp <%= number_with_delimiter(@properti.harga_pasar) %></div>
        <p><strong>Range rekomendasi:</strong></p>
        <p>Min: Rp <%= number_with_delimiter(@properti.harga_rekomendasi_min.to_i) %></p>
        <p>Mid: Rp <%= number_with_delimiter(@properti.harga_rekomendasi_mid.to_i) %></p>
        <p>Max: Rp <%= number_with_delimiter(@properti.harga_rekomendasi_max.to_i) %></p>
        <%= link_to "Kembali ke Listings", listings_path, class: "btn block" %>
      </div>
    </div>
  </div>
</section>

<section class="container section">
  <% if @properti.latitude.present? && @properti.longitude.present? %>
    <div class="card listing-map-shell">
      <div class="card-content">
        <div class="listing-map-copy">
          <div>
            <span class="badge">Leaflet + OpenStreetMap</span>
            <h2>Lokasi Properti</h2>
            <p>Peta ini menampilkan posisi listing berdasarkan koordinat yang tersimpan.</p>
          </div>
          <div class="listing-map-stats">
            <span><%= @properti.latitude %>, <%= @properti.longitude %></span>
          </div>
        </div>
      </div>
      <div
        id="listing-detail-map"
        class="listing-map"
        data-title="<%= @properti.alamat %>"
        data-address="<%= [@properti.daerah, @properti.kecamatan, @properti.kelurahan].compact_blank.join(", ") %>"
        data-price="<%= rupiah(@properti.harga_pasar) %>"
        data-land-area="<%= @properti.luas_tanah %>"
        data-latitude="<%= @properti.latitude %>"
        data-longitude="<%= @properti.longitude %>"
      ></div>
    </div>
  <% else %>
    <div class="card card-content empty-state">
      <h2>Lokasi belum tersedia</h2>
      <p>Listing ini belum memiliki koordinat, jadi peta belum bisa ditampilkan.</p>
    </div>
  <% end %>
</section>

<!-- FOOTER -->
<footer>
  <div class="container footer-inner">
    <div>© 2025 SPK Properti</div>
    <div>
      <%= link_to "Privacy", privacy_path %> ·
      <%= link_to "Terms", terms_path %> ·
      <%= link_to "FAQ", faq_path %>
    </div>
  </div>
</footer>

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const hamburger = document.getElementById("hamburger");
    const navLinks = document.getElementById("nav-links");
    const mapElement = document.getElementById("listing-detail-map");

    if (hamburger && navLinks) {
      hamburger.addEventListener("click", function () {
        navLinks.classList.toggle("open");
      });

      document.addEventListener("click", function (e) {
        if (!navLinks.contains(e.target) && !hamburger.contains(e.target)) {
          navLinks.classList.remove("open");
        }
      });
    }

    if (mapElement && window.L) {
      const latitude = Number(mapElement.dataset.latitude);
      const longitude = Number(mapElement.dataset.longitude);

      const map = L.map(mapElement, { scrollWheelZoom: false }).setView([latitude, longitude], 15);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);

      const escapeHtml = function (value) {
        return String(value || "").replace(/[&<>"']/g, function (char) {
          return {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
          }[char];
        });
      };

      const popupHtml = `
        <div class="map-popup">
          <strong>${escapeHtml(mapElement.dataset.title)}</strong>
          <p>${escapeHtml(mapElement.dataset.address)}</p>
          <p>${escapeHtml(mapElement.dataset.price)} · ${escapeHtml(mapElement.dataset.landArea)} m²</p>
        </div>
      `;

      L.marker([latitude, longitude]).addTo(map).bindPopup(popupHtml).openPopup();
    }
  });
</script>

</body>
</html>
