<% content_for :title, @properti.alamat %>
<% content_for :active_nav, "listings" %>
<% content_for :head do %>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  >
<% end %>
<% content_for :page_scripts do %>
  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
<% end %>

<main id="content">
  <section class="hero">
    <div class="container">
      <h1 data-page="Detail"><%= @properti.alamat %></h1>
      <p>Informasi lengkap properti</p>
    </div>
  </section>

  <section class="container" style="margin-top:2rem">
    <div class="grid cols-2">
      <div class="card">
        <div class="card-content">
          <p><strong>Daerah:</strong> <%= @properti.daerah %></p>
          <p><strong>Kecamatan:</strong> <%= @properti.kecamatan %></p>
          <p><strong>Kelurahan:</strong> <%= @properti.kelurahan %></p>
          <p><strong>Luas Tanah:</strong> <%= @properti.luas_tanah %> m²</p>
          <p><strong>Luas Bangunan:</strong> <%= @properti.luas_bangunan %> m²</p>
          <p><strong>Tahun:</strong> <%= @properti.tahun_pembangunan %></p>
          <p><strong>Status Kepemilikan:</strong> <%= @properti.status_kepemilikan %></p>
          <p><strong>NJOP:</strong> Rp <%= number_with_delimiter(@properti.njop.to_i) %> / m²</p>
        </div>
      </div>

      <div class="card">
        <div class="card-content">
          <div class="price">Rp <%= number_with_delimiter(@properti.harga_pasar) %></div>
          <p><strong>Range rekomendasi:</strong></p>
          <p>Min: Rp <%= number_with_delimiter(@properti.harga_rekomendasi_min.to_i) %></p>
          <p>Mid: Rp <%= number_with_delimiter(@properti.harga_rekomendasi_mid.to_i) %></p>
          <p>Max: Rp <%= number_with_delimiter(@properti.harga_rekomendasi_max.to_i) %></p>
          <%= link_to "Kembali ke Listings", listings_path, class: "btn block" %>
        </div>
      </div>
    </div>
  </section>

  <section class="container section">
    <% if @properti.latitude.present? && @properti.longitude.present? %>
      <div class="card listing-map-shell">
        <div class="card-content">
          <div class="listing-map-copy">
            <div>
              <span class="badge">Leaflet + OpenStreetMap</span>
              <h2>Lokasi Properti</h2>
              <p>Peta ini menampilkan posisi listing berdasarkan koordinat yang tersimpan.</p>
            </div>
            <div class="listing-map-stats">
              <span><%= @properti.latitude %>, <%= @properti.longitude %></span>
            </div>
          </div>
        </div>
        <div
          id="listing-detail-map"
          class="listing-map"
          data-title="<%= @properti.alamat %>"
          data-address="<%= [@properti.daerah, @properti.kecamatan, @properti.kelurahan].compact_blank.join(", ") %>"
          data-price="<%= rupiah(@properti.harga_pasar) %>"
          data-land-area="<%= @properti.luas_tanah %>"
          data-latitude="<%= @properti.latitude %>"
          data-longitude="<%= @properti.longitude %>"
        ></div>
      </div>
    <% else %>
      <div class="card card-content empty-state">
        <h2>Lokasi belum tersedia</h2>
        <p>Listing ini belum memiliki koordinat, jadi peta belum bisa ditampilkan.</p>
      </div>
    <% end %>
  </section>
</main>
