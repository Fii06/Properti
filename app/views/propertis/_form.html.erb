<%= form_with(model: @properti, local: true) do |f| %>

<div class="card">
  <div class="card-content">

    <div class="form-row">
      <div>
        <%= f.label :alamat %>
        <%= f.text_field :alamat %>
      </div>

      <div>
        <%= f.label :harga_pasar %>
        <%= f.number_field :harga_pasar %>
      </div>
    </div>

    <div class="form-row">
      <div>
        <%= f.label :luas_tanah %>
        <%= f.number_field :luas_tanah %>
      </div>

      <div>
        <%= f.label :luas_bangunan %>
        <%= f.number_field :luas_bangunan %>
      </div>
    </div>

    <%= f.submit "Simpan Properti", class: "btn block", style: "margin-top:1rem" %>

  </div>
</div>

<% end %>
