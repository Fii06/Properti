<div class="container py-5">
<div class="row">


<div class="col-md-6">
<img src="https://via.placeholder.com/600x400" class="img-fluid rounded-4 shadow-sm" />
</div>


<div class="col-md-6">
<h2 class="fw-bold mb-3"><%= @properti.alamat %></h2>
<p class="text-muted">Koordinat: <%= @properti.latitude %>, <%= @properti.longitude %></p>
<p>Luas Tanah: <%= @properti.luas_tanah %> m²</p>
<p>Luas Bangunan: <%= @properti.luas_bangunan %> m²</p>
<p>Tahun Dibangun: <%= @properti.tahun_pembangunan %></p>
<p>Status Kepemilikan: <%= @properti.status_kepemilikan %></p>
<p>NJOP: Rp <%= number_with_delimiter(@properti.njop) %></p>
<p>Harga Pasar: Rp <%= number_with_delimiter(@properti.harga_pasar) %></p>


<a class="btn btn-primary rounded-pill px-4 mt-3" href="/propertis/<%= @properti.id %>/edit">Edit</a>
<%= link_to 'Kembali', propertis_path, class: "btn btn-secondary" %>
</div>


</div>
</div>
