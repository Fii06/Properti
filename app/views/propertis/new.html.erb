<h1>Jual Properti (SPK)</h1>

<%= form_with model: @properti, url: listings_path, local: true do |f| %>

  <%= f.label :alamat %>
  <%= f.text_field :alamat, class: "input", required: true %>

  <div class="form-row">
    <div>
      <%= f.label :luas_tanah, "Luas Tanah (m²)" %>
      <%= f.number_field :luas_tanah, class: "input" %>
    </div>
    <div>
      <%= f.label :luas_bangunan, "Luas Bangunan (m²)" %>
      <%= f.number_field :luas_bangunan, class: "input" %>
    </div>
  </div>

  <%= f.label :njop, "NJOP (Rp)" %>
  <%= f.number_field :njop, class: "input" %>

  <%= f.label :images, "Upload Foto (min. 5)" %>
  <%= f.file_field :images, multiple: true, class: "input" %>

  <br>
  <%= f.submit "Simpan & Hitung Harga", class: "btn" %>

<% end %>
